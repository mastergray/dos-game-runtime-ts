{
  "name": "dos-game-runtime-ts",
  "version": "0.1.1",
  "description": "Run DOS games in the browser with a headless js-dos runtime using a manifest that turns game assets into a standalone web app",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./shell": "./manifests/shell/shell.ts",
    "./manifest": "./manifests/shell/manifest.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "manifests/shell",
    "scripts/bundle.ts",
    "scripts/build-manifests.ts",
    "scripts/serve-dir.ts",
    "bin"
  ],
  "scripts": {
    "check": "run-s check:src check:tests",
    "check:src": "tsc --noEmit",
    "check:tests": "tsc -p tsconfig.tests.json",
    "clean": "node scripts/clean-dist.mjs",
    "compile": "tsc",
    "compile:package": "tsc -p tsconfig.package.json",
    "build": "run-s clean compile",
    "build:package": "run-s clean compile:package",
    "prepare": "npm run build:package",
    "test": "node --import tsx tests/run.ts spec",
    "test:spec": "node --import tsx tests/run.ts spec",
    "test:browser": "node --import tsx tests/run.ts browser",
    "test:all": "node --import tsx tests/run.ts spec browser",
    "harness": "node --import tsx scripts/serve-harness.ts",
    "pack-bundle": "node --import tsx scripts/pack-bundle.ts",
    "manifest-schema": "node --import tsx scripts/manifest-schema.ts",
    "build-manifests": "node --import tsx scripts/build-manifests.ts",
    "serve-dir": "node --import tsx scripts/serve-dir.ts"
  },
  "author": "mastergray",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastergray/dos-game-runtime-ts.git"
  },
  "homepage": "https://github.com/mastergray/dos-game-runtime-ts#readme",
  "bugs": "https://github.com/mastergray/dos-game-runtime-ts/issues",
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ctg-js-browser-test": "github:claymoretechgroup/ctg-js-browser-test#v2.0.0",
    "ctg-js-test": "github:claymoretechgroup/ctg-js-test#v4.0.0",
    "npm-run-all": "^4.1.5",
    "playwright": "1.62.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "emulators": "8.4.2",
    "esbuild": "0.28.2",
    "tsx": "^4.23.11"
  },
  "bin": {
    "dos-build-manifests": "bin/build-manifests.mjs",
    "dos-serve-dir": "bin/serve-dir.mjs"
  }
}
